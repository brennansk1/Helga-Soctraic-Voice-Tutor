# === Helga Socratic Tutor Configuration ===

# LLM Model — Nail-Qwen3.6-35B-A3B (MoE: 34.7B total, ~3B active per token).
# NOT pullable from a registry: it is imported locally from a GGUF.
# See docs/MODEL.md for the one-time import. Measured on the M4 Pro 24GB:
#   ~29 tok/s decode (1.7x the old 9B), ~119s per hydrated concept (2.3x faster),
#   0.0 repetition on the real builder prompt, 256K context.
OLLAMA_MODEL=nail-35b-a3b

# Host settings that matter for a 13GB model on a 24GB box:
#   OLLAMA_MAX_LOADED_MODELS=1   deterministic eviction instead of a memory race
OLLAMA_URL=http://host.docker.internal:11434

# How long Ollama holds the weights after the last request — the knob that
# trades the two scarcest resources on this box against each other.
#
# Resident, the model is ~12.7 GB against a measured safe ceiling of ~15.0 GB,
# and past ~16.4 GB the machine thrashes; that boundary is a cliff, not a
# slope. Pinning the model (-1) spends most of that headroom on the hours
# nobody is studying, which are precisely the hours the night audit,
# verification passes and host-native TTS/STT want the RAM. Letting it go is
# not free either: reloading costs ~133s from the external disk, paid by
# whoever asks the next question.
#
# 30m splits the difference. It comfortably outlasts a student staring at a
# hard question, so nothing inside a session pays the reload, and the memory
# comes back once a session is genuinely over. Use -1 to restore pin-forever
# on a machine with headroom to spare, or 0 to unload after every request.
#
# Set it here, not only on the host: every LLM request carries a keep_alive
# field read from this variable, and a per-request value OVERRIDES the
# server's own OLLAMA_KEEP_ALIVE. A host set to evict plus a container still
# sending -1 gives you -1. docker-compose.yml passes this through to
# core-logic and rag-engine for that reason.
OLLAMA_KEEP_ALIVE=30m

# B23.1/B23.2: GPU admission gate (core-logic). Must equal the host's
# OLLAMA_NUM_PARALLEL or the gate and Ollama drift.
OLLAMA_NUM_PARALLEL=4

# B23.3: set these on the HOST before `ollama serve` (Ollama runs on metal,
# not in a container). These are not optional tuning — each one is worth more
# than anything in this file:
#   launchctl setenv OLLAMA_KEEP_ALIVE 30m         # idle eviction (see above)
#   launchctl setenv OLLAMA_MAX_LOADED_MODELS 1    # one model only, no VRAM thrash
#   launchctl setenv OLLAMA_NUM_PARALLEL 4         # concurrency slots (= gate cap above)
#   launchctl setenv OLLAMA_CONTEXT_LENGTH 8192    # see below — 4096 truncates mastery 4-5
#
# KEEP_ALIVE: Ollama's own default is five idle minutes, which is shorter than
# a student's pause to think — that is why the value is set explicitly at all,
# and why it is 30m rather than 5m. Set the same value in both places: the host
# variable governs the server's own timer, the container variable rides on each
# request and wins wherever the /v1 shim honours it.
#
# Note that core-logic still logs a startup warning when it finds the model
# unpinned (LLMClient.warn_if_not_pinned). With idle eviction deliberately on,
# that warning is now expected and describes the old policy, not a fault.
#
# CONTEXT_LENGTH: many Modelfiles default num_ctx to 4096 regardless of what
# the model supports. A mastery-5 concept is contracted at up to 2,200 words
# (~3,000 tokens) on top of a ~900-token prompt, which does not fit — the
# generation is cut off and then fails the depth contract as "too short",
# triggering a full regeneration that cannot succeed either. Check yours with
# `ollama show <model>` before blaming the model for short output.

# Background LLM concurrency for course building. Defaults to
# OLLAMA_NUM_PARALLEL - 1, leaving one slot permanently reserved so a live
# student is never queued behind a build. Set to 1 to build single-file.
# HELGA_BG_SLOTS=3

# B15.6: per-student FSM registry sizing
FSM_REGISTRY_MAX=64
FSM_IDLE_TTL=1800
FSM_SWEEP_INTERVAL=60

# Flask
FLASK_ENV=production
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Optional: Cloudflare tunnel for remote access
# CLOUDFLARED_TOKEN=your_token_here

# Pedagogy settings
DEFAULT_VOICE=af_heart

# ── Split models: large for batch, 9B for interactive (SPRINT_PLAN A4.1c) ────
# Course building is batch — the user already waits minutes and the artifact is
# durable — so quality is worth latency there. Tutoring is the opposite. Unset,
# both roles resolve to OLLAMA_MODEL and nothing changes.
#
# Gate any candidate with `tools/model_gate.py` BEFORE trusting it: this
# project already found a model that produced clean output on a simplified
# prompt (4/4) and degenerated into repetition on the real builder prompt
# (3/3). See docs/MODE_A_STATUS.md §5.
#
# HELGA_BUILD_MODEL=qwen3.6:27b
# HELGA_BUILD_URL=http://host.docker.internal:11434
# For an MLX model served by mlx_lm.server on its own port:
# HELGA_BUILD_URL=http://host.docker.internal:8080
