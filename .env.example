# === Helga Socratic Tutor Configuration ===

# LLM Model (must be pulled via: ollama pull qwen3.5:9b)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://host.docker.internal:11434

# B23.1/B23.2: GPU admission gate (core-logic). Must equal the host's
# OLLAMA_NUM_PARALLEL or the gate and Ollama drift.
OLLAMA_NUM_PARALLEL=4

# B23.3: set these on the HOST before `ollama serve` (Ollama runs on metal,
# not in a container). These are not optional tuning — each one is worth more
# than anything in this file:
#   launchctl setenv OLLAMA_KEEP_ALIVE -1          # pin model in memory, no cold reloads
#   launchctl setenv OLLAMA_MAX_LOADED_MODELS 1    # one model only, no VRAM thrash
#   launchctl setenv OLLAMA_NUM_PARALLEL 4         # concurrency slots (= gate cap above)
#   launchctl setenv OLLAMA_CONTEXT_LENGTH 8192    # see below — 4096 truncates mastery 4-5
#
# KEEP_ALIVE: without it Ollama unloads after five idle minutes. A student
# reading a question and thinking about it routinely exceeds that, so the next
# answer pays a multi-second cold load of a 9B before generating a token.
# core-logic warns at startup if it finds the model unpinned (see
# LLMClient.warn_if_not_pinned); the requests also carry keep_alive, but the
# OpenAI-compatible /v1 shim may ignore it depending on Ollama version.
#
# CONTEXT_LENGTH: many Modelfiles default num_ctx to 4096 regardless of what
# the model supports. A mastery-5 concept is contracted at up to 2,200 words
# (~3,000 tokens) on top of a ~900-token prompt, which does not fit — the
# generation is cut off and then fails the depth contract as "too short",
# triggering a full regeneration that cannot succeed either. Check yours with
# `ollama show <model>` before blaming the model for short output.

# Background LLM concurrency for course building. Defaults to
# OLLAMA_NUM_PARALLEL - 1, leaving one slot permanently reserved so a live
# student is never queued behind a build. Set to 1 to build single-file.
# HELGA_BG_SLOTS=3

# B15.6: per-student FSM registry sizing
FSM_REGISTRY_MAX=64
FSM_IDLE_TTL=1800
FSM_SWEEP_INTERVAL=60

# Flask
FLASK_ENV=production
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Optional: Cloudflare tunnel for remote access
# CLOUDFLARED_TOKEN=your_token_here

# Pedagogy settings
DEFAULT_VOICE=af_heart
